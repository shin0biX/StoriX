# Copy to .env (Docker Compose reads it automatically) or export these values
# before starting uvicorn locally.
#
# Generate a production secret:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Required in production --------------------------------------------------
STORIX_ENV=production
STORIX_SECRET_KEY=replace-with-a-random-64-byte-value

# Optional. Defaults to a value derived from STORIX_SECRET_KEY.
# STORIX_SHARE_SECRET_KEY=

# --- Persistence -------------------------------------------------------------
# Local defaults are ./hosting.db and ./storage. Docker uses /data.
STORIX_DATABASE_URL=sqlite:///./hosting.db
STORIX_STORAGE_ROOT=./storage

# --- Public URLs / proxy -----------------------------------------------------
# Used to build absolute share links. Set this to the public origin.
STORIX_BASE_URL=http://localhost:8000
# Comma-separated hostnames accepted by TrustedHostMiddleware. Empty = allow all.
STORIX_TRUSTED_HOSTS=
# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty when the frontend is served by this same app.
STORIX_CORS_ORIGINS=

# --- Tokens ------------------------------------------------------------------
STORIX_ACCESS_TOKEN_MINUTES=30
STORIX_REFRESH_TOKEN_DAYS=14
STORIX_REFRESH_ROTATION_GRACE_SECONDS=60

# --- Product policy ----------------------------------------------------------
# false in production: only admins can move users between plans.
STORIX_ALLOW_SELF_PLAN_CHANGE=false
# Public API docs (/docs, /openapi.json). Defaults to false in production.
STORIX_ENABLE_DOCS=false

# --- Limits ------------------------------------------------------------------
STORIX_MAX_FILENAME_LENGTH=120
STORIX_MAX_UPLOAD_FILES=50
STORIX_SHARE_MAX_MINUTES=10080
STORIX_ZIP_MAX_BYTES=2147483648
STORIX_ZIP_MAX_FILES=1000
STORIX_LOGIN_RATE_LIMIT=10
STORIX_LOGIN_RATE_WINDOW_SECONDS=300
STORIX_REGISTER_RATE_LIMIT=10
STORIX_REGISTER_RATE_WINDOW_SECONDS=3600
STORIX_UPLOAD_RATE_LIMIT=240
STORIX_UPLOAD_RATE_WINDOW_SECONDS=60
STORIX_SHARE_RATE_LIMIT=60
STORIX_SHARE_RATE_WINDOW_SECONDS=60
